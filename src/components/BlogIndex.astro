---
import Base from '../layouts/Base.astro';
import { routes, formatDate } from '../i18n.js';
import { posts, byYear, cats } from '../lib/posts.js';
const { lang } = Astro.props;
const de = lang === 'de';
const SHOW_EXCERPT = true;
const counts = new Map();
posts.forEach((p) => cats(p, lang).forEach((c) => counts.set(c, (counts.get(c) || 0) + 1)));
const allCats = [...counts.entries()].sort((a, b) => b[1] - a[1]);
const slug = (c) => c.toLowerCase().replace(/[^a-zäöü]+/g, '-');
---
<Base lang={lang} title="Blog" current="blog" alt={routes.blog[de ? 'en' : 'de']}>
  <h1>Blog</h1>
  <div class="blog-filter" role="group" aria-label={de ? 'Nach Kategorie filtern' : 'Filter by category'}>
    <button type="button" class="chip on" data-cat="">{de ? 'Alle' : 'All'} <span>{posts.length}</span></button>
    {allCats.map(([c, n]) => <button type="button" class="chip" data-cat={slug(c)}>{c} <span>{n}</span></button>)}
  </div>
  {byYear(posts).map(([year, list]) => (
    <section class="blog-year" data-year={year}>
      <div class="year">{year}</div>
      <ul class="post-cards">
        {list.map((p) => (
          <li data-cats={cats(p, lang).map(slug).join(' ')}>
            <a href={p.urlFor(lang)} class="post-card">
              <span class={p.image ? 'pc-img riso-shadow' : 'pc-img pc-empty'}>
                {p.image ? <img src={p.image} alt="" loading="lazy" width="168" height="112" /> : <span>{year}</span>}
              </span>
              <span class="pc-body">
                <span class="pc-meta">
                  <time datetime={p.date}>{formatDate(p.date, lang)}</time>
                  {cats(p, lang).map((c) => <span class="pc-cat">{c}</span>)}
                </span>
                <span class="pc-title">{p.v(lang).title}</span>
                {SHOW_EXCERPT && p.v(lang).excerpt && <span class="pc-ex">{p.v(lang).excerpt}</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
  <script is:inline>
    (() => {
      const chips = document.querySelectorAll('.blog-filter .chip');
      chips.forEach((b) => b.addEventListener('click', () => {
        chips.forEach((x) => x.classList.toggle('on', x === b));
        const c = b.dataset.cat;
        document.querySelectorAll('.post-cards li').forEach((li) => { li.hidden = !!c && !li.dataset.cats.split(' ').includes(c); });
        document.querySelectorAll('.blog-year').forEach((s) => { s.hidden = ![...s.querySelectorAll('li')].some((li) => !li.hidden); });
      }));
    })();
  </script>
</Base>
