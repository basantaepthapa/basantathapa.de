---
import Base from '../layouts/Base.astro';
import { marked } from 'marked';
import { routes, t } from '../i18n.js';
import talks from '../data/talks.json';
const { lang } = Astro.props;
const s = t[lang];
const de = lang === 'de';
const groups = [];
for (const e of talks) {
  let g = groups.find((x) => x.name === e.section);
  if (!g) groups.push((g = { name: e.section, items: [] }));
  g.items.push(e);
}
groups.sort((a, b) => b.name.localeCompare(a.name));
---
<Base lang={lang} title={s.nav.talks} current="talks" alt={routes.talks[de ? 'en' : 'de']}>
  <h1>{s.nav.talks}</h1>
  <p class="note">{de ? 'Englischsprachige Titel und Veranstaltungen stehen im Original. Stand der Liste: 2020.' : 'Titles of German-language talks and events are translated and marked "(in German)". List as of 2020.'}</p>
  {groups.map((g) => (
    <section>
      <div class="year">{g.name}</div>
      <ul class="entries">
        {g.items.map((e) => <li set:html={marked.parseInline(de ? e.text_de : e.text_en)} />)}
      </ul>
    </section>
  ))}
</Base>
