---
import Base from '../layouts/Base.astro';
import { marked } from 'marked';
import { routes, t } from '../i18n.js';
import talks from '../data/talks.json';
const { lang } = Astro.props;
const s = t[lang];
const de = lang === 'de';
const groups = [];
for (const e of talks) {
  let g = groups.find((x) => x.name === e.section);
  if (!g) groups.push((g = { name: e.section, items: [] }));
  g.items.push(e);
}
groups.sort((a, b) => b.name.localeCompare(a.name));
---
<Base lang={lang} title={s.nav.talks} current="talks" alt={routes.talks[de ? 'en' : 'de']}>
  <h1>{s.nav.talks}</h1>
  {de && <p class="note">Die Einträge stehen auf Englisch. Stand der Liste: 2020.</p>}
  {groups.map((g) => (
    <section>
      <div class="year">{g.name}</div>
      <ul class="entries" lang="en">
        {g.items.map((e) => <li set:html={marked.parseInline(e.text)} />)}
      </ul>
    </section>
  ))}
</Base>
