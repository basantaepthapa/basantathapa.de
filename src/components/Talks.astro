---
import Base from '../layouts/Base.astro';
import Toc from './Toc.astro';
import { marked } from 'marked';
import { routes, t } from '../i18n.js';
import talks from '../data/talks.json';
const { lang } = Astro.props;
const s = t[lang];
const de = lang === 'de';
const groups = [];
for (const e of talks) {
  let g = groups.find((x) => x.name === e.section);
  if (!g) groups.push((g = { name: e.section, items: [] }));
  g.items.push(e);
}
groups.sort((a, b) => b.name.localeCompare(a.name));
---
<Base lang={lang} title={s.nav.talks} current="talks" alt={routes.talks[de ? 'en' : 'de']}>
  <h1>{s.nav.talks}</h1>
  <p class="note">{de ? 'Englischsprachige Titel und Veranstaltungen stehen im Original.' : 'Titles of German-language talks and events are translated and marked "(in German)".'}</p>
  <Toc lang={lang} items={groups.map((g) => ({ id: `y${g.name}`, label: g.name, count: g.items.length }))} />
  {groups.map((g) => (
    <section id={`y${g.name}`}>
      <div class="year">{g.name}</div>
      <ul class="entries">
        {g.items.map((e) => (
          <li class="pub">
            {e.thumb ? (
              <span class="pub-thumb wide"><img src={e.thumb} alt="" loading="lazy" /></span>
            ) : (
              <span class="pub-thumb wide pub-thumb-empty" aria-hidden="true"></span>
            )}
            <div set:html={marked.parseInline(de ? e.text_de : e.text_en)} />
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
