---
import Base from '../layouts/Base.astro';
import { marked } from 'marked';
import { routes, t } from '../i18n.js';
import pubs from '../data/publications.json';
const { lang } = Astro.props;
const s = t[lang];
const de = lang === 'de';
const names = {
  'Journal articles': 'Zeitschriftenartikel',
  'Book chapters': 'Buchkapitel',
  'Edited Volumes': 'Herausgeberschaften',
  'Conference proceedings': 'Tagungsbeiträge',
  'Reports/White Papers/Working Papers': 'Studien, Whitepaper und Working Papers',
  'Guest articles and columns': 'Gastbeiträge und Kolumnen',
  'Blog posts': 'Blogbeiträge',
};
const firstLink = (text) => (text.match(/\]\(([^)\s]+)\)/) || [])[1];
const slug = (n) => n.toLowerCase().replace(/[^a-z]+/g, '-').replace(/^-|-$/g, '');
const label = (n) => de ? (names[n] ?? n) : n.replace('/', ', ').replace('/', ' and ');
const groups = [];
for (const e of pubs) {
  let g = groups.find((x) => x.name === e.section);
  if (!g) groups.push((g = { name: e.section, items: [] }));
  g.items.push(e);
}
---
<Base lang={lang} title={s.nav.pubs} current="pubs" alt={routes.pubs[de ? 'en' : 'de']}>
  <h1>{s.nav.pubs}</h1>
  <p class="note">{de ? 'Die Einträge stehen in der Originalsprache.' : 'Titles of German-language publications are translated and marked "(in German)".'}</p>
  <nav class="toc" aria-label={de ? 'Inhalt' : 'Contents'}>
    <ul>
      {groups.map((g) => (
        <li><a href={`#${slug(g.name)}`}>{label(g.name)} <span>{g.items.length}</span></a></li>
      ))}
    </ul>
  </nav>
  {groups.map((g) => (
    <section id={slug(g.name)}>
      <h3>{label(g.name)}</h3>
      <ul class="entries">
        {g.items.map((e) => (
          <li class="pub">
            {e.thumb ? (
              <a class={e.thumb.includes("/articles/") ? "pub-thumb wide" : "pub-thumb"} href={firstLink(e.text)} tabindex="-1" aria-hidden="true">
                <img src={e.thumb} alt="" loading="lazy" />
              </a>
            ) : (
              <span class={["Guest articles and columns","Blog posts"].includes(e.section) ? "pub-thumb wide pub-thumb-empty" : "pub-thumb pub-thumb-empty"} aria-hidden="true"></span>
            )}
            <div set:html={marked.parseInline(de ? e.text : (e.text_en ?? e.text))} />
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
