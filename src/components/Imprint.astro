---
import Base from '../layouts/Base.astro';
import { routes, t, EMAIL } from '../i18n.js';
const { lang } = Astro.props;
const s = t[lang];
const de = lang === 'de';
---
<Base lang={lang} title={s.imprint} alt={routes.imprint[de ? 'en' : 'de']}>
  <div class="prose">
    <h1>{s.imprint}</h1>
    <p>{de ? 'Angaben gemäß § 5 Digitale-Dienste-Gesetz (DDG)' : 'Information pursuant to Section 5 of the German Digital Services Act (DDG)'}</p>
    <p>Basanta E.P. Thapa<br />Riastraße 11<br />10318 Berlin</p>
    <p>{de ? 'E-Mail' : 'Email'}: <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
    <p>{de ? 'Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV' : 'Responsible for content under Section 18(2) MStV'}: Basanta E.P. Thapa, {de ? 'Anschrift wie oben' : 'address as above'}</p>
    <p class="muted small">{de ? 'Für die Inhalte externer Links sind ausschließlich deren Betreiber verantwortlich.' : 'The operators of linked external websites are solely responsible for their content.'}</p>
  </div>
</Base>
