---
import Base from '../layouts/Base.astro';
import Toc from './Toc.astro';
import { marked } from 'marked';
import degrees from '../data/courses.json';
const { lang } = Astro.props;
const de = lang === 'de';
const L = (o, k) => (de ? o[`${k}_de`] ?? o[k] : o[k]);
const count = (g) => g.terms.reduce((n, t) => n + t.courses.length, 0);
const short = de
  ? { phd: 'Promotion', ma: 'Master', ba: 'Bachelor', school: 'Schule' }
  : { phd: 'Doctorate', ma: 'Master', ba: 'Bachelor', school: 'School' };
const md = (s) => marked.parseInline(s);
---
<Base lang={lang} title={de ? 'Lehrveranstaltungen' : 'Courses'} current="about" alt={de ? '/archive/courses/' : '/archiv/kurse/'}>
  <p class="post-meta">{de ? <a href="/ueber-mich/">Über mich</a> : <a href="/en/about/">About</a>} · {de ? 'Archiv' : 'Archive'}</p>
  <h1>{de ? 'Lehrveranstaltungen' : 'Courses'}</h1>
  <p class="note">{de
    ? 'Die wichtigsten Lehrveranstaltungen aus Schule, Bachelor, Master und Promotionsstudium, mit den Hausarbeiten, Abschlussarbeiten und Präsentationen, die ich dafür geschrieben habe. Die Dokumente sind in der jeweiligen Originalsprache.'
    : "The substantial courses I took from school through my bachelor's, master's and doctoral studies, with the term papers, theses and presentations I wrote for them."}</p>
  <Toc lang={lang} items={degrees.map((g) => ({ id: g.id, label: short[g.id], count: count(g) }))} />
  {degrees.map((g) => (
    <section id={g.id} class="degree">
      <h2>{L(g, 'name')}</h2>
      {(g.place || g.years) && <p class="degree-meta">{[L(g, 'place'), g.years].filter(Boolean).join(' · ')}</p>}
      {g.terms.map((t) => (
        <div class="term">
          <div class="term-name">{L(t, 'name')}</div>
          <ul class="courses">
            {t.courses.map((c) => (
              <li class="course">
                <div class="course-title">{L(c, 'title')}</div>
                {c.teachers && <div class="course-by">{c.teachers}</div>}
                {L(c, 'notes').map((n) => <p class="course-note" set:html={md(n)} />)}
                {(c.papers ?? []).map((p) => (
                  <a class={p.wide ? 'paper wide' : 'paper'} href={p.url}>
                    <img src={p.thumb} alt="" loading="lazy" />
                    <span>
                      <span class="paper-meta">{[L(p, 'kind'), L(p, 'lang'), p.year].filter(Boolean).join(' · ')}</span>
                      <span class="paper-title">{L(p, 'title')}</span>
                      {p.desc && <span class="paper-desc">{L(p, 'desc')}</span>}
                    </span>
                  </a>
                ))}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  ))}
</Base>
