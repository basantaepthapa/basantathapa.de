---
import '@fontsource/roboto-slab/700.css';
import '@fontsource/roboto-slab/800.css';
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/400-italic.css';
import '@fontsource/source-sans-3/600.css';
import '../styles/global.css';
import { routes, t } from '../i18n.js';

const { lang = 'de', title, description = '', current = '', alt, contentLang } = Astro.props;
const s = t[lang];
const other = lang === 'de' ? 'en' : 'de';
const altHref = alt ?? routes.home[other];
const nav = [
  { k: 'home' },
  { k: 'about', sub: ['profile', 'engagement', 'training', 'studies'] },
  { k: 'pubs' }, { k: 'talks' }, { k: 'press' }, { k: 'blog' }, { k: 'contact' },
];
const href = (k) => routes[k === 'profile' ? 'about' : k][lang];
const isCur = (k) => current === k || (k === 'profile' && current === 'about');
const inGroup = (n) => n.sub ? n.sub.some(isCur) : current === n.k;
const fullTitle = title ? `${title} · Basanta E.P. Thapa` : 'Basanta E.P. Thapa';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={contentLang ?? lang} class="riso">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang={other} href={new URL(altHref, Astro.site)} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:title" content={fullTitle} />
  {description && <meta property="og:description" content={description} />}
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#inhalt">{s.skip}</a>
  <header class="site-header" lang={lang}>
    <div class="wrap">
      <a class="brand" href={routes.home[lang]}>Basanta E.P. Thapa</a>
      <nav class="site-nav" aria-label={lang === 'de' ? 'Hauptmenü' : 'Main menu'}>
        <ul class="nav-list">
          {nav.map((n) => n.sub ? (
            <li class="has-sub">
              <details class="nav-drop">
                <summary class={inGroup(n) ? 'cur' : undefined}>{s.nav[n.k]}</summary>
                <ul class="sub">
                  {n.sub.map((c) => <li><a href={href(c)} aria-current={isCur(c) ? 'page' : undefined}>{s.nav[c]}</a></li>)}
                </ul>
              </details>
            </li>
          ) : (
            <li><a href={href(n.k)} aria-current={isCur(n.k) ? 'page' : undefined}>{s.nav[n.k]}</a></li>
          ))}
        </ul>
      </nav>
      <div class="nav-side">
        <a class="lang" href={altHref} hreflang={other} lang={other} aria-label={s.switchTo}>{other.toUpperCase()}</a>
        <details class="burger">
          <summary aria-label={s.nav.menu}><span class="bars" aria-hidden="true"></span>{s.nav.menu}</summary>
          <ul class="burger-list">
            {nav.map((n) => n.sub ? (
              <li><span class={inGroup(n) ? 'grp cur' : 'grp'}>{s.nav[n.k]}</span>
                <ul>{n.sub.map((c) => <li><a href={href(c)} aria-current={isCur(c) ? 'page' : undefined}>{s.nav[c]}</a></li>)}</ul>
              </li>
            ) : (
              <li><a href={href(n.k)} aria-current={isCur(n.k) ? 'page' : undefined}>{s.nav[n.k]}</a></li>
            ))}
          </ul>
        </details>
      </div>
    </div>
  </header>
  <main id="inhalt" class="wrap">
    <slot />
  </main>
  <footer class="site-footer" lang={lang}>
    <div class="wrap">
      <span>© {new Date().getFullYear()} Basanta E.P. Thapa</span>
      <span><a href={routes.imprint[lang]}>{s.imprint}</a> · <a href={routes.privacy[lang]}>{s.privacy}</a></span>
    </div>
  </footer>
  <script is:inline>
    document.addEventListener('click', (e) => {
      document.querySelectorAll('details.nav-drop[open], details.burger[open]').forEach((d) => { if (!d.contains(e.target)) d.removeAttribute('open'); });
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') document.querySelectorAll('details.nav-drop[open], details.burger[open]').forEach((d) => d.removeAttribute('open')); });
  </script>
</body>
</html>
