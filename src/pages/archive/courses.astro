---
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';
import { marked } from 'marked';
import degrees from '../../data/courses.json';
const count = (g) => g.terms.reduce((n, t) => n + t.courses.length, 0);
const short = { phd: 'PhD', ma: 'Master', ba: 'Bachelor', school: 'School' };
const md = (s) => marked.parseInline(s).replace(/<a href="\/uploads\/([^"]+\.pdf)"/g, '<a class="pdf" href="/uploads/$1"');
---
<Base lang="en" title="Courses" current="about" alt="/ueber-mich/">
  <p class="post-meta"><a href="/en/about/">About</a> · Archive</p>
  <h1>Courses</h1>
  <p class="note">The substantial courses I took during my bachelor's, master's and doctoral studies, from 2006 to 2015, with the term papers, theses and presentations I wrote for them.</p>
  <Toc lang="en" items={degrees.map((g) => ({ id: g.id, label: short[g.id], count: count(g) }))} />
  {degrees.map((g) => (
    <section id={g.id} class="degree">
      <h2>{g.name}</h2>
      {(g.place || g.years) && <p class="degree-meta">{[g.place, g.years].filter(Boolean).join(' · ')}</p>}
      {g.terms.map((t) => (
        <div class="term">
          <div class="term-name">{t.name}</div>
          <ul class="courses">
            {t.courses.map((c) => (
              <li class="course">
                <div class="course-title">{c.title}</div>
                {c.teachers && <div class="course-by">{c.teachers}</div>}
                {c.notes.map((n) => <p class="course-note" set:html={md(n)} />)}
                {(c.papers ?? []).map((p) => (
                  <a class={p.wide ? "paper wide" : "paper"} href={p.url}>
                    <img src={p.thumb} alt="" loading="lazy" />
                    <span>
                      <span class="paper-meta">{[p.kind, p.lang, p.year].filter(Boolean).join(' · ')}</span>
                      <span class="paper-title">{p.title}</span>
                      {p.desc && <span class="paper-desc">{p.desc}</span>}
                    </span>
                  </a>
                ))}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  ))}
</Base>
