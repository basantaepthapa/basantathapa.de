---
import Base from '../../layouts/Base.astro';

const modules = import.meta.glob('../../archive/*.md', { eager: true });
export function getStaticPaths() {
  const modules = import.meta.glob('../../archive/*.md', { eager: true });
  return Object.entries(modules).map(([path, mod]) => ({
    params: { slug: path.split('/').pop().replace(/\.md$/, '') },
    props: { mod },
  }));
}
const { mod } = Astro.props;
const { Content, frontmatter } = mod;
---
<Base lang="en" title={frontmatter.title} current="about" alt="/ueber-mich/">
  <article class="prose">
    
    <h1>{frontmatter.title}</h1>
    <Content />
  </article>
</Base>
